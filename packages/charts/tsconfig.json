{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "es2018",
    "lib": [
      "es2019",
      "dom"
    ],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@platform-blocks/charts": [
        "./index.ts"
      ],
      "@platform-blocks/charts/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/**/demos/**/*",
    "src/**/__examples__/**/*",
    "index.ts"
  ]
}
