{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@plocks/ui/test-utils": ["../ui/src/__test-utils__/index.ts"],
      "@plocks/ui": ["../ui/src/index.ts"],
      "@plocks/qrcode": ["./src/index.ts"]
    },
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/*",
    "../ui/src/core/platform/react-native-web.d.ts",
    "../ui/src/components/Icon/icons/tabler-deep-imports.d.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "src/**/demos/**/*"
  ]
}
