{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "module": "esnext",
    // Kept on the legacy "node" (node10) resolver on purpose, which is why
    // `ignoreDeprecations` is set. react-native 0.86's legacy typings import
    // themselves by package name ('react-native/types/private/Utilities', ...)
    // while its package.json "exports" maps "./types/*" to null, so under
    // "bundler"/"node16" those imports fail to resolve and every RN host
    // component (View, Text, ScrollView...) stops being a valid JSX element
    // type (~1,600 errors). Revisit when RN's exports map allows its own type
    // self-references (or when moving to its strict API types).
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    // Paths resolve relative to this file (no baseUrl). Demos import the
    // package by its public name; these point that at the source.
    "paths": {
      "platform-blocks": [
        "./src/index.ts"
      ],
      "platform-blocks/*": [
        "./src/*"
      ],
      "@platform-blocks/ui": [
        "./src/index.ts"
      ],
      "@platform-blocks/ui/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "lib/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/**/__tests__/**/*",
    "src/**/__web_tests__/**/*",
    // Test-only helpers and mocks (jest.setup.cjs, test files); never shipped.
    "src/__test-utils__/**/*",
    "src/**/demos/**/*",
    "src/**/__examples__/**/*"
  ]
}
