{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ],
    "target": "es2018",
    "lib": [
      "es2018",
      "esnext.asynciterable",
      "dom"
    ],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "baseUrl": "./src",
    "paths": {
      "@tabler/icons-react-native": [
        "../../../node_modules/@tabler/icons-react-native/dist/tabler-icons-react-native.d.ts"
      ],
      "platform-blocks": [
        "./index.ts"
      ],
      "platform-blocks/*": [
        "./*"
      ],
      "@platform-blocks/ui": [
        "./index.ts"
      ],
      "@platform-blocks/ui/*": [
        "./*"
      ],
      "@platform-blocks/charts": [
        "../charts/src/index.ts"
      ],
      "@platform-blocks/charts/*": [
        "../charts/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "lib/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/**/demos/**/*",
    "src/**/__examples__/**/*"
  ]
}